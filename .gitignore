node_modules
dist

# Your colony: which repo sits on which plot, and what you archived. Holds the names and
# paths of the repos you work in, so it stays out of the repository.
data/*.json
data/*.tmp

# Business Tasks is the exception: it's hand-authored content (Sherman's actual to-do list),
# not colony bookkeeping, and it has no other backup or history anywhere. Tracking it gives a
# real changelog for free — `git log -p data/business-tasks.json` is every edit ever made to
# it, in order, with a diff. See the "Change history" note in server/harnesses/business-tasks.mjs.
!data/business-tasks.json

# Per-machine Claude Code permissions — personal paths live in here.
.claude/settings.local.json

# Raw asset packs. The built glbs in public/assets are checked in instead — see the README
# under "Where the art comes from" for how to re-fetch these if you need to rebuild.
assets-src

.DS_Store
*.log

# Local capture output — not part of the project.
recordings
